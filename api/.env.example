# Copy to api/.env before `docker compose up --build`:
#
#   cp api/.env.example api/.env
#
# The containers will not start until FERNET_KEY and SECRET_KEY are filled in.

# --- Database ---------------------------------------------------------------
# Matches the postgres service in docker-compose.yml -- change them together.
# bin/pgenv.sh derives PGHOST / PGUSER / PGPASSWORD / PGPORT / PGDATABASE from
# this one string, so psql (bash) and the Ansible playbooks share it.
DATABASE_URL=postgresql://mcp:mcp@postgres:5432/multicloud

# --- Web session ----------------------------------------------------------
# Signs the Flask session cookie. Any long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# --- Cloud credential encryption ----------------------------------------
# Encrypts the cloud keys users hand over, before they reach Postgres.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this makes every stored credential undecryptable, so keep it.
FERNET_KEY=

# --- Provisioning limits ------------------------------------------------
# Where the terraform modules and per-tenant workspaces live in the container;
# docker-compose mounts ./terraform there.
TERRAFORM_ROOT=/terraform
# One live resource per provider per user, destroyed after this many hours.
MAX_RESOURCES_PER_PROVIDER=1
AUTO_DESTROY_HOURS=24
